<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Calculadora de Puntajes UDG</title>
  <style>
    body {
      font-family: 'Barlow', sans-serif;
      margin: 0;
      padding: 0;
      background: linear-gradient(135deg, #eef2f3, #dff1f1);
    }

    .container {
      max-width: 1000px;
      margin: 40px auto;
      padding: 30px;
      border-radius: 20px;
      background: #ffffff;
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
      font-size: 14px;
    }

    .header {
      text-align: center;
      margin-bottom: 30px;
    }

    .header h1 {
      font-size: 38px;
      font-weight: 900;
      color: #0328C9;
      background: none;
      padding: 0;
      margin: 0;
      position: relative;
      display: inline-block;
    }

    .header h1::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -8px;
      width: 100%;
      height: 4px;
      background-color: #21A537;
      border-radius: 2px;
    }

    label {
      margin: 15px 0 5px;
      font-size: 15px;
      font-weight: bold;
      color: #444;
    }

    select, input {
      width: 100%;
      padding: 12px 15px;
      margin-bottom: 20px;
      border: none;
      border-radius: 12px;
      background: #f2f2f2;
      box-shadow: inset 2px 2px 5px #ccc, inset -2px -2px 5px #fff;
      font-size: 16px;
      color: #333;
      transition: all 0.3s ease;
    }

    select:focus, input:focus {
      outline: none;
      background: #ffffff;
      box-shadow: 0 0 10px rgba(3, 40, 201, 0.2);
    }

    button {
      width: 100%;
      padding: 14px;
      background-color: #0328C9;
      color: #fff;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      font-size: 18px;
      font-weight: bold;
      transition: background-color 0.3s ease, transform 0.2s ease;
    }

    button:hover {
      background-color: #0040b2;
      transform: scale(1.02);
    }

    #resultContainer {
      display: none;
      margin-top: 30px;
      padding: 25px;
      border-radius: 15px;
      background: #fdfdfd;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }

    #resultContainer h2 {
      font-size: 32px;
      color: #0328C9;
      font-weight: bold;
      margin-bottom: 20px;
    }

    #resultTable {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    #resultTable th, #resultTable td {
      padding: 15px;
      border-bottom: 1px solid #ccc;
      font-size: 15px;
    }

    #resultTable th {
      background-color: #f5f5f5;
      color: #333;
      text-align: center;
    }

    #resultTable td {
      font-weight: 600;
      text-align: left;
    }

    #resultTable tbody tr:nth-child(odd) {
      background-color: #ffffff;
    }

    #resultTable tbody tr:nth-child(even) {
      background-color: #f2f2f2;
    }

    #resultTable tbody tr.highlight td {
      background-color: #d4edda !important;
    }

    #graphContainer {
      margin-top: 30px;
      text-align: center;
    }

    #graphContainer canvas {
      max-width: 100%;
      max-height: 400px;
    }

#graphTitle {
    font-size: 28px;
    color: #0328C9;
    margin-bottom: 15px;
}

#recommendation {
  margin-top: 20px;
  font-size: 16px;
  text-align: center;
}

#disclaimer {
      margin-top: 30px;
      padding: 18px;
      background-color: #fff3cd;
      color: #856404;
      font-weight: bold;
      border-radius: 12px;
      border-left: 6px solid #ffeeba;
      font-size: 16px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    #disclaimer::before {
      content: "\26A0";
      font-size: 22px;
    }

    @media (max-width: 600px) {
      .container {
        padding: 20px;
      }

      .header h1, #resultContainer h2 {
        font-size: 22px;
      }

      label, select, input, button {
        font-size: 14px;
      }

      #resultTable th, #resultTable td {
        font-size: 13px;
        padding: 10px;
      }
    }
  </style>
</head>
