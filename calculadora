            function getCourseRecommendation(career) {
                var c = career.toUpperCase().trim();
                if (integralCareers.includes(c)) return 'INTEGRAL';
                if (exponencialCareers.includes(c)) return 'EXPONENCIAL';
                if (radicalCareers.includes(c)) return 'RADICAL';
                if (fiftyCareers.includes(c)) return '50 TEMAS MAS PREGUNTADOS';
                return 'INTEGRAL';
            }

            function loadOptions() {
                var campusSelect = document.getElementById('campus');
                var campusOptions = [];

                data.forEach(function(item) {
                    if (!campusOptions.includes(item.CAMPUS)) {
                        campusOptions.push(item.CAMPUS);
                        var option = document.createElement('option');
                        option.text = item.CAMPUS;
                        option.value = item.CAMPUS;
                        campusSelect.add(option);
                    }
                });

                filterCareers();
            }

            function filterCareers() {
                var campusSelect = document.getElementById('campus');
                var careerSelect = document.getElementById('career');
                var selectedCampus = campusSelect.value;

                careerSelect.innerHTML = '';
                var careers = data.filter(function(item) {
                    return item.CAMPUS === selectedCampus;
                });

                careers.forEach(function(career) {
                    var option = document.createElement('option');
                    option.text = career.CARRERA;
                    option.value = career.CARRERA;
                    careerSelect.add(option);
                });
            }

                        function calculateScore() {
                var campus = document.getElementById('campus').value;
                var career = document.getElementById('career').value;
                var average = parseFloat(document.getElementById('average').value);
                var careerData = data.filter(function(item) {
                    return item.CARRERA === career;
                });

                if (careerData.length > 0) {
                    var results = careerData.map(function(item) {
                        var minScore = item["PUNTAJE MÍNIMO"];
                        return {
                            campus: item.CAMPUS,
                            aspirantes: item.ASPIRANTES,
                            admitidos: item.ADMITIDOS,
                            noAdmitidos: item["NO ADMITIDOS"],
                            porcentaje: item["% ADMISIÓN"] * 100,
                            minScore: minScore,
                            puntajeNecesario: minScore - average
                        };
                    });

                    var selectedIndex = results.findIndex(function(r) { return r.campus === campus; });
                    var selectedRow = selectedIndex > -1 ? results.splice(selectedIndex, 1)[0] : null;
                    results.sort(function(a, b) { return b.puntajeNecesario - a.puntajeNecesario; });

                    var tbody = document.querySelector('#resultTable tbody');
                    tbody.innerHTML = '';

                    function appendRow(r, highlight) {
                        var tr = document.createElement('tr');
                        if (highlight) {
                            tr.classList.add('highlight');
                        }
                        tr.innerHTML = "<td>" + r.campus + "</td>" +
                                       "<td>" + r.aspirantes + "</td>" +
                                       "<td>" + r.admitidos + "</td>" +
                                       "<td>" + r.noAdmitidos + "</td>" +
                                       "<td>" + r.porcentaje.toFixed(0) + "%</td>" +
                                       "<td>" + r.minScore.toFixed(2) + "</td>" +
                                       "<td>" + r.puntajeNecesario.toFixed(2) + "</td>";
                        tbody.appendChild(tr);
                    }

                    if (selectedRow) {
                        appendRow(selectedRow, true);
                    }
                    results.forEach(function(r) { appendRow(r, false); });

                    document.getElementById('resultContainer').style.display = 'block';
                    document.getElementById('graphTitle').innerText = 'Estadísticas de admisión en "' + campus + ' - ' + career + '"';
                    drawChart(selectedRow.admitidos, selectedRow.noAdmitidos);
                    document.getElementById('graphContainer').style.display = 'block';
                    var recommendedCourse = getCourseRecommendation(career);
                    var recDiv = document.getElementById('recommendation');
                    recDiv.innerHTML = 'Como necesitas <strong>' + selectedRow.puntajeNecesario.toFixed(2) + '</strong> puntos en tu examen, el curso que te recomendamos es <strong>' + recommendedCourse + '</strong>';
                    recDiv.style.display = 'block';
                } else {
                    document.getElementById('resultContainer').style.display = 'none';
                    document.getElementById('graphContainer').style.display = 'none';
                    document.getElementById('recommendation').style.display = 'none';
                }
            }

            function drawChart(admitidos, noAdmitidos) {
                if (chartInstance) {
                    chartInstance.destroy();
                }
                var ctx = document.getElementById('myChart').getContext('2d');
                chartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Admitidos', 'No admitidos'],
                        datasets: [{
                            label: 'Estadísticas de Admisión',
                            data: [admitidos, noAdmitidos],
                            backgroundColor: [
                                'rgba(54, 162, 235, 0.2)',
                                'rgba(255, 99, 132, 0.2)'
                            ],
                            borderColor: [
                                'rgba(54, 162, 235, 1)',
                                'rgba(255, 99, 132, 1)'
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            }

            loadOptions();

            document.getElementById('campus').addEventListener('change', function() {
                filterCareers();
            });

            document.getElementById('calculateButton').addEventListener('click', function() {
                calculateScore();
            });
        });
